# New Studio variables. Existing authentication/billing/API environment is unchanged.
# Leave disabled in production until a separate authorization/deployment review.
CLIPFORGE_ENABLE_STUDIOS=0
# Public mode verifies sessions, ownership and existing billing.
# The credential-free dev entry point explicitly uses loopback-only mode.
CLIPFORGE_STUDIOS_LOCAL_ONLY=0
# Absolute local paths to pre-existing models and writable Studio data; no downloads.
CLIPFORGE_MODELS_DIR=
CLIPFORGE_STUDIO_DATA_DIR=
# Offline overrides. Linux requires a Linux llama-server executable.
CLIPFORGE_LOCAL_MODEL=
# Optional isolated speech environment; does not alter production Python packages.
CLIPFORGE_THUMBNAIL_SPEECH_PYTHON=
CLIPFORGE_ANALYSIS_MODEL=
CLIPFORGE_LLAMA_SERVER=
CLIPFORGE_VISION_MODEL=
CLIPFORGE_VISION_PROJECTOR=
# Optional server-only adapter override: installed_python_module:factory_function
# The factory receives api_key=... and config={...}; blank selects built-in KIE
# when the existing server key below is present.
CLIPFORGE_VIDEO_PROVIDER_FACTORY=
CLIPFORGE_VIDEO_PROVIDER_CONFIG={}
# Existing Render secret variable reused by KIE. Leave real values in Render.
CLIPFORGE_VIDEO_PROVIDER_API_KEY=
# KIE adapters use the existing key variable above. No key value is committed.
# Blank factories auto-select KIE when that key is present; explicit adapters win.
CLIPFORGE_IMAGE_PROVIDER_FACTORY=
# Keep disabled until a live paid test / generation has been explicitly approved.
CLIPFORGE_KIE_ALLOW_PAID_REQUESTS=0
# Optional account-only one-shot video test; global paid switch stays 0.
# Set all three only after explicit approval. Keep the same approval ID on restart.
# One 5-second 720p Wan 2.7 request: 80 credits (~USD 0.40); cap cannot exceed USD 1.
CLIPFORGE_KIE_TEST_USER_ID=
CLIPFORGE_KIE_TEST_APPROVAL_ID=
CLIPFORGE_KIE_TEST_BUDGET_USD=
