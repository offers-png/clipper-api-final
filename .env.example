# New Studio variables. Existing authentication/billing/API environment is unchanged.
# Leave disabled in production until a separate authorization/deployment review.
CLIPFORGE_ENABLE_STUDIOS=0
# Absolute local paths to pre-existing models and writable Studio data; no downloads.
CLIPFORGE_MODELS_DIR=
CLIPFORGE_STUDIO_DATA_DIR=
# Optional future server-only adapter: installed_python_module:factory_function
# The factory receives api_key=... and config={...}; no vendor is preselected.
CLIPFORGE_VIDEO_PROVIDER_FACTORY=
CLIPFORGE_VIDEO_PROVIDER_CONFIG={}
# NEW optional generic secret name, not a discovered existing Render variable.
# Populate securely only when the chosen adapter requires API authentication.
CLIPFORGE_VIDEO_PROVIDER_API_KEY=
